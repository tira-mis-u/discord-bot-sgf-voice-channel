# ===== Runtime =====
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string
# Local/Docker only. On Vercel this is automatically redirected to ephemeral /tmp.
DB_FILE=./data/sgf.sqlite

# ===== PostgreSQL / Supabase =====
# Runtime URL: use Supavisor session pooler for a persistent bot worker,
# or transaction pooler for serverless web functions.
DATABASE_URL=
POSTGRES_POOL_MAX=10
# Direct database URL for migrations, pg_dump and restore.
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Redis cache / sessions / distributed locks =====
# Standard Redis provider:
REDIS_URL=
# Or Upstash REST credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Study Voice developers =====
# Discord User IDs with global system, revenue, SePay and all-server access.
DEV_DANTE=
DEV_TIRA=

# ===== Discord application =====
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Must exactly match the redirect URI in Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ===== SePay =====
# API key from SePay API Access. The backend uses it to discover linked bank accounts.
# Configure the SePay webhook to use the same API Key if you want a single secret.
SEPAY_API_KEY=your_sepay_api_key
# Optional override only when the webhook uses a different key:
SEPAY_WEBHOOK_API_KEY=

# ===== SGF website integration =====
# Requests to /api/integrations/sgf/* must send this secret.
SGF_INTEGRATION_SECRET=change-this-integration-secret
# Optional: every paid order is POSTed here as an event.
SGF_EVENTS_WEBHOOK_URL=
