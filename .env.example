# ===== Runtime =====
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string
# Local/Docker only. On Vercel this is automatically redirected to ephemeral /tmp.
DB_FILE=./data/sgf.sqlite

# ===== PostgreSQL / Supabase =====
# Runtime URL: use Supavisor session pooler for a persistent bot worker,
# or transaction pooler for serverless web functions.
DATABASE_URL=
POSTGRES_POOL_MAX=10
# Direct database URL for migrations, pg_dump and restore.
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Redis cache / sessions / distributed locks =====
# Standard Redis provider:
REDIS_URL=
# Or Upstash REST credentials:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Study Voice developers =====
# Discord User IDs with global system, revenue, SePay and all-server access.
DEV_DANTE=
DEV_TIRA=

# ===== Discord application =====
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Must exactly match the redirect URI in Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ===== SePay / VietQR =====
# The webhook API key configured in my.sepay.vn -> Integrations -> Webhooks.
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key
# Optional global payment account. Per-guild values can be overridden in Dashboard.
SEPAY_BANK_CODE=VCB
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_ACCOUNT_NAME=SGF
# If you only have a static QR image, put its public URL here.
# Dynamic QR is preferred because it embeds amount + unique order code.
SEPAY_STATIC_QR_URL=
# The official QR image endpoint used by the starter.
SEPAY_QR_BASE_URL=https://vietqr.app/img
# SePay API v2 token from Company Settings -> API Access.
# Keep this server-side only. The token is never returned to the browser.
SEPAY_API_TOKEN=
# Production: https://userapi.sepay.vn/v2
# Sandbox:    https://userapi-sandbox.sepay.vn/v2
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
# Deprecated alias accepted for backward compatibility:
SEPAY_ACCESS_TOKEN=

# ===== SGF website integration =====
# Requests to /api/integrations/sgf/* must send this secret.
SGF_INTEGRATION_SECRET=change-this-integration-secret
# Optional: every paid order is POSTed here as an event.
SGF_EVENTS_WEBHOOK_URL=
