{
  "name": "sgf-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord voice room, premium role and SePay/VietQR payment bot for SGF",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "db:reset": "node scripts/reset-db.mjs",
    "db:migrate:supabase": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "verify": "node scripts/verify-fixes.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@upstash/redis": "^1.38.2",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.21.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "postgres": "^3.4.9",
    "redis": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
